# Kopirajte u .env.local i popunite. Bez ovih vrednosti "Poruči" na checkoutu
# vraća grešku i upućuje kupca na telefon — porudžbina se ne gubi, ali ne dolazi na mejl.

# API ključ sa resend.com (besplatan plan je dovoljan za male količine)
RESEND_API_KEY=

# Pošiljalac. Mora biti adresa na domenu verifikovanom na Resend nalogu.
#
# Ne mora to biti medzapotenciju.com: mejl sa porudžbinom stiže samo vlasniku
# radnje, a kupčeva adresa ide u reply-to, pa kupac adresu pošiljaoca nikad ne
# vidi. Bilo koji već verifikovan domen sa istog naloga je dovoljan.
#
# Za brzi test bez verifikovanog domena radi i onboarding@resend.dev, ali tada
# Resend isporučuje samo na mejl kojim je nalog otvoren.
ORDER_EMAIL_FROM="Porudžbine <porudzbine@send.zimdigital.rs>"

# Gde stižu porudžbine. Ako se izostavi, koristi se medzapotencijuonline@gmail.com
ORDER_EMAIL_TO=medzapotencijuonline@gmail.com


# ─── ADMIN ZA SADRŽAJ (/keystatic) ────────────────────────────────────────────
#
# LOKALNO: ništa od ovoga ne treba. `npm run dev` pa /keystatic — admin piše
# direktno u fajlove u content/ i ne traži nikakvo prijavljivanje.
#
# NA PRODUKCIJI: bez ovih vrednosti admin se otvara, ali ne može ništa da
# sačuva, jer datoteke na Vercelu nisu upisive. Zato se tamo piše u GitHub repo,
# a za to treba GitHub App.
#
# Kako se dobijaju: otvorite https://keystatic.com/docs/github-app-setup i
# pratite korake — kreira GitHub App za repo zimstudioonline/med-za-potenciju i
# na kraju ispiše sve četiri vrednosti. Unesite ih u Vercel → Settings →
# Environment Variables.
#
# Ko sme da uređuje: svako ko ima write pristup tom GitHub repou. Nema zasebnih
# naloga ni lozinki — prijavljivanje ide preko GitHub-a.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
